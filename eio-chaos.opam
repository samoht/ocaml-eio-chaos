# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Chaos tests of Eio programs on simulated devices that fail together"
description: """
eio-chaos runs an Eio program many times on simulated devices, each
time with one failure the real kernel can produce, and restarts it on what the
failure left. The devices are parts that other packages provide, such as a disk
or a network. Eio_chaos.run builds the program's env from them, with simulated
clocks, seeded entropy and captured output, and reports the first failure with
a line that replays it."""
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
license: "ISC"
tags: ["eio" "testing" "chaos"]
homepage: "https://github.com/samoht/ocaml-eio-chaos"
bug-reports: "https://github.com/samoht/ocaml-eio-chaos/issues"
depends: [
  "dune" {>= "3.21"}
  "hermetic" {>= "0.1.0"}
  "ocaml" {>= "5.4"}
  "eio" {>= "1.7"}
  "fmt"
  "cstruct" {>= "6.2.0"}
  "mtime"
  "psq"
  "domain-local-await"
  "mdx" {with-test & >= "2.3.0"}
  "alcotest" {with-test & >= "1.7.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/samoht/ocaml-eio-chaos.git"
x-maintenance-intent: ["(latest)"]
