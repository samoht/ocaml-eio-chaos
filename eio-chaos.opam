# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Chaos tests of Eio programs on simulated devices that fail together"
description: """
eio-chaos runs an Eio program many times on simulated devices, each
time with a fault the real kernel can produce or a power cut, and restarts it
on what the fault left. The devices come from other packages, such as a
disk or a network; its README builds a toy one, to read as an
example. Eio_chaos.run builds the program's env from them, with simulated
clocks, seeded entropy and captured output, and reports the first failing run
with a line that replays it."""
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
license: "ISC"
tags: ["eio" "test" "chaos"]
homepage: "https://github.com/samoht/ocaml-eio-chaos"
bug-reports: "https://github.com/samoht/ocaml-eio-chaos/issues"
depends: [
  "dune" {>= "3.21"}
  "hermetic" {>= "0.1.0"}
  "ocaml" {>= "5.4"}
  "eio" {>= "1.7"}
  "fmt"
  "console" {>= "0.9.0"}
  "cstruct" {>= "6.2.0"}
  "mtime" {>= "2.0.0"}
  "psq"
  "domain-local-await"
  "mdx" {with-test & >= "2.3.0"}
  "alcotest" {with-test & >= "1.7.0"}
  "alcobar" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/samoht/ocaml-eio-chaos.git"
x-maintenance-intent: ["(latest)"]
